# Supabase project (EU, Frankfurt). Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used for invites and webhooks, never sent to the browser.
SUPABASE_SECRET_KEY=
# Public origin, used in emails and auth redirects.
NEXT_PUBLIC_SITE_URL=https://portal.rideff.com
# Stripe (test keys first). Payment methods are a filter on what is activated in the dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHODS=card,sepa_debit,klarna
# Resend (domain rideff.com must be verified). Without a key no email is sent.
RESEND_API_KEY=
EMAIL_FROM=RIDEFF <hallo@rideff.com>
